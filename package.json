{
  "name": "axios-crud",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.19.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "concurrently -k -n api,app -c blue,magenta \"npm run server\" \"npm run app\"",
    "dev": "npm start",
    "server": "npm --prefix phone-server start",
    "app": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "expo": {
    "install": {
      "//": "Expo Go 57.0.6 bundles the native side of gesture-handler 2.x. Upgrading the JS to 3.x makes it call RNGestureHandlerModule.installUIRuntimeBindings(), which does not exist there, and the app red-screens on launch. Pin to 2.x until Expo Go ships the 3.x native module (a custom dev build can use 3.x today).",
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "private": true
}
